include LICENSE README.md CONTRIBUTING.md CHANGELOG.md
include SECURITY.md CODE_OF_CONDUCT.md THIRD_PARTY_NOTICES.md RELEASE.md
include pyproject.toml apkfast.py
recursive-include include *.hpp *.h *.c *.cpp *.md LICENSE*
recursive-include src *.cpp *.c
recursive-include patches *.diff *.patch *.md
recursive-include docs *.md
recursive-include examples *
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod] *.apk *.a *.so *.o
